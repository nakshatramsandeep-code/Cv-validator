# Neon Postgres pooled connection string. Get from Neon console > Connection Details,
# or `neon connection-string --pooled` once the project is linked. Never commit the real value.
DATABASE_URL=

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Current Gemini Flash model id. Check https://ai.google.dev/gemini-api/docs/models for updates.
GEMINI_MODEL=gemini-3.8-flash

# Resend API key (https://resend.com/api-keys). Leave blank to disable sending; the UI
# will show "Email not configured" instead of erroring.
RESEND_API_KEY=

# Sender identity for outgoing mail. With the default onboarding@resend.dev sender and no
# verified domain, Resend only delivers to the email address that owns the Resend account.
EMAIL_FROM=Kargo Hiring <onboarding@resend.dev>

# When set, every send is redirected here instead of the candidate's real address, with the
# subject prefixed "[TEST -> <original email>]". Leave blank only when every candidate email is a
# synthetic test address you control; set it whenever real candidate emails might be reached.
TEST_RECIPIENT_EMAIL=

# Simple shared password protecting every page and API route. Change before deploying.
DASHBOARD_PASSWORD=
